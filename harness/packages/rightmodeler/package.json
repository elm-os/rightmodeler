{
  "name": "rightmodeler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "rightmodeler": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @rightmodeler/scanner build && pnpm --filter @rightmodeler/kernel build && pnpm --filter @rightmodeler/replay build && tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "check": "pnpm run build && tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@rightmodeler/core": "workspace:*",
    "@rightmodeler/kernel": "workspace:*",
    "@rightmodeler/replay": "workspace:*",
    "@rightmodeler/scanner": "workspace:*",
    "commander": "^14",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
