{
  "name": "@rightmodeler/cli",
  "version": "0.6.3",
  "description": "Cheaper model swaps for production AI, validated on your own traces and opened as draft PRs.",
  "keywords": [
    "ai-agents",
    "agent-evals",
    "llm-evals",
    "llm-as-a-judge",
    "model-validation",
    "cost-optimization",
    "llmops",
    "traces",
    "production-ai",
    "regression-testing"
  ],
  "homepage": "https://www.rightmodeler.com",
  "type": "module",
  "bin": {
    "rightmodeler": "./dist-bundle/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist-bundle/cli.js"
    }
  },
  "files": [
    "dist-bundle",
    "docs"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "directory": "dist/publish",
    "linkDirectory": false
  },
  "scripts": {
    "build": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json && pnpm run bundle",
    "bundle": "tsx scripts/generate-docs.mjs --check && node build.mjs",
    "docs:generate": "tsx scripts/generate-docs.mjs --write",
    "prepack": "pnpm run bundle",
    "parity": "pnpm run build && vitest run src/parity.test.ts",
    "check-types": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "check": "vitest run"
  },
  "devDependencies": {
    "@repo/contracts": "workspace:*",
    "@rightmodeler/core": "workspace:*",
    "@rightmodeler/kernel": "workspace:*",
    "@rightmodeler/replay": "workspace:*",
    "@rightmodeler/scanner": "workspace:*",
    "@types/node": "^24",
    "@typescript/native": "npm:typescript@7.0.2",
    "ajv": "^8.20.0",
    "commander": "^14",
    "esbuild": "^0.28.2",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3",
    "yaml": "2.9.1",
    "zod": "^4"
  },
  "optionalDependencies": {
    "@vercel/sandbox": "^3.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elm-os/rightmodeler.git",
    "directory": "harness/packages/rightmodeler"
  }
}
