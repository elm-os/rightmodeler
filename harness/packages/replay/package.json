{
  "name": "@rightmodeler/replay",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && node node_modules/@typescript/native/bin/tsc -p src/proxy/tsconfig.build.json && node src/proxy/build-runtime.mjs",
    "check-types": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "check": "node node_modules/@typescript/native/bin/tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@rightmodeler/core": "workspace:*",
    "@rightmodeler/executor": "workspace:*",
    "@rightmodeler/kernel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@typescript/native": "npm:typescript@7.0.2",
    "openai": "7.4.0",
    "typescript": "^5",
    "vitest": "^3"
  }
}
