{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "enable_logging": true,
    "compat": {
      "convert_text_to_chat": false,
      "convert_chat_to_responses": false,
      "should_drop_params": false,
      "should_convert_params": false,
      "azure_deepseek": false
    }
  },
  "providers": {
    "vercel": {
      "keys": [
        {
          "name": "vercel-1",
          "value": "env.AI_GATEWAY_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": { "base_url": "https://ai-gateway.vercel.sh" },
      "custom_provider_config": { "base_provider_type": "openai" }
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": { "path": "./logs.db" }
  }
}
