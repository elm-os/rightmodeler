{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".github/workflows/ci.yml",
    ".npmrc",
    "package.json",
    "pnpm-workspace.yaml"
  ],
  "globalEnv": ["RUNNER_OS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "build/**",
        "dist/**",
        "dist-bundle/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "cache": false
    },
    "check": {
      "dependsOn": ["build", "^build", "^check"],
      "env": ["CI", "RIGHTMODELER_SKIP_DOCKER"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/harness/fixtures/**",
        "$TURBO_ROOT$/harness/tsconfig.base.json"
      ]
    },
    "@rightmodeler/cli#check": {
      "dependsOn": ["build", "^build", "@rightmodeler/executor#check"],
      "env": ["CI", "RIGHTMODELER_SKIP_DOCKER"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/harness/docs/parity.md",
        "$TURBO_ROOT$/harness/fixtures/**",
        "$TURBO_ROOT$/harness/tsconfig.base.json",
        "$TURBO_ROOT$/skills/rightmodeler/SKILL.md",
        "$TURBO_ROOT$/skills/rightmodeler/reference/**"
      ]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@rightmodeler/agent#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@rightmodeler/rightmodeler-skill#build": {
      "outputs": []
    }
  }
}
