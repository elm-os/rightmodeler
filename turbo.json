{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "build/**",
        "dist/**",
        "dist-bundle/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "cache": false
    },
    "check": {
      "dependsOn": ["build", "^build", "^check"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/harness/fixtures/**"]
    },
    "@rightmodeler/cli#check": {
      "dependsOn": ["build", "^build", "^check"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/harness/docs/parity.md",
        "$TURBO_ROOT$/harness/fixtures/**",
        "$TURBO_ROOT$/skills/rightmodeler/**"
      ]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@rightmodeler/agent#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@rightmodeler/rightmodeler-skill#build": {
      "outputs": []
    }
  }
}
