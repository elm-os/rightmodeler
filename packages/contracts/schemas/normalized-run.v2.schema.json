{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rightmodeler.com/schemas/normalized-run.v2.schema.json",
  "title": "Normalized Run",
  "type": "object",
  "required": ["version", "traceId", "sourceFormat", "steps"],
  "properties": {
    "version": {
      "const": "2"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "sourceFormat": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "usage": {
      "type": "object",
      "required": ["inputTokens", "outputTokens"],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "stepIndex",
        "model",
        "messages",
        "output",
        "usage",
        "trajectoryId"
      ],
      "properties": {
        "stepIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "systemPrompt": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        "output": { "$ref": "#/$defs/jsonValue" },
        "usage": { "$ref": "#/$defs/usage" },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "trajectoryId": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
