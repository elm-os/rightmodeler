{
  "name": "rightmodeler",
  "private": true,
  "description": "Cheaper model swaps for production AI, validated on your own traces and opened as draft PRs.",
  "license": "MIT",
  "homepage": "https://www.rightmodeler.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elm-os/rightmodeler.git"
  },
  "keywords": [
    "ai-agents",
    "agent-evals",
    "llm-evals",
    "llm-as-a-judge",
    "model-validation",
    "cost-optimization",
    "llmops",
    "traces",
    "production-ai",
    "regression-testing"
  ],
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format && prettier --write .",
    "parity": "pnpm --filter @rightmodeler/cli run parity",
    "check": "turbo run check && node scripts/unreferenced-exports.mjs",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.5"
  }
}
